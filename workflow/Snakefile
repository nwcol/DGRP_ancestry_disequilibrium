# Simplify VCFs and split them by chromosome

rule split_raw_dgrp_vcf:
    # Simplify the DGRP-3 VCF and split it by chromosome.
    # bcftools view arguments:
    #   -r : Subset to arm {wilcards.chrom}.
    #   -v snps : Subset to SNPs (the input file includes indels).
    # bcftools annotate arguments:
    #   -x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/GQ : Drop all INFO fields and all
    #       FORMAT fields except GT:AD:GQ.
    #   -W : Index the output file.
    input:
        "../data/vcfs/DGRP-3_final_biallelic-new.vcf.gz",
        index="../data/vcfs/DGRP-3_final_biallelic-new.vcf.gz.csi"
    output:
        "../results/vcfs/DGRP_{chrom}.vcf.gz"
    shell:
        """
        bcftools view -r {wildcards.chrom} -v snps {input} | \
            bcftools annotate -x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/GQ -W -o {output}
        """

rule split_raw_panel_vcf:
    # Subset, split by chromosome, and simplify the ZI, ET, FR panel VCF.
    # Map chromosome labels from numeric codes to strings, e.g. 7 -> 2R.
    # bcftools view arguments:
    #   -S : Subset samples to samples in {input.samples}
    #   -r : Subset sites to {wildcards.chrom_code}
    # bcftools annotate arguments:
    #   --rename-chrs : Maps chromosome names as described above.
    #   -x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/GQ : Drop all INFO fields and all
    #       FORMAT fields except GT:AD:GQ.
    #   -W : Index the output file.
    input:
        vcf="../data/vcfs/ZI_ET_FR_combined_all_num_biallelic.vcf.gz",
        index="../data/vcfs/ZI_ET_FR_combined_all_num_biallelic.vcf.gz.csi",
        chrom_map="../data/inverse_chr_map.txt",
        samples="../results/FR_ZI_samples.txt"
    output:
        "../results/vcfs/FR_ZI_{chrom}.vcf.gz"
    params:
        chrom_code = get_chrom_code
    shell:
        """
        bcftools view -S {input.samples} -r {params.chrom_code} {input.vcf} | \
            bcftools annotate --rename-chrs {input.chrom_map} \
            -x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/GQ -W -o {output}
        """


# Extract information about VCF contents

rule extract_site_data:
    # Extract position, reference/alternate allele, and alternate allele
    # count from chromosome and dataset (DGRP, FR/ZI)-specific VCFs.
    input:
        "../results/vcfs/{label}_{chrom}.vcf.gz"
    output:
        "../results/site_data/{label}_{chrom}.tsv"
    shell:
        """
        bcftools +fill-tags {input} | \
            bcftools query -f'%CHROM\t%POS\t%REF\t%ALT\t%AC\n' > {output}
        """

rule merge_site_data:
    input:
        script="scripts/build_ref_alt_table.py",
        fr_zi="../results/site_info/FR_ZI_{chrom}.tsv",
        dgrp="../results/site_info/DGRP_{chrom}.tsv"
    output:
        "../results/site_info/merged_{chrom}.tsv"
    shell:
        """
        python {input.script} \
            -i {input.fr_zi} {input.dgrp} \
            --labels panel dgrp \
            -o {output}
        """


# Merge VCFs

rule merge_vcfs:
    # Merge DGRP and panel VCFs and drop sites that aren't biallelic SNPs
    # Bcftools flags:
    #   -m2 -M2 : Keep only biallelic sites
    #   -g ^miss : Keep only sites with no missing genotypes. Because there is
    #       no missingness in the DGRP-3 or panel VCF files, missing sites in
    #       the merged file should be sites where the minor allele is private
    #       to the DGRP or panels; such sites are not useful to us.
    #   -W : Create an index file for the output VCF
    input:
        dgrp="../results/vcfs/DGRP_{chrom}.vcf.gz",
        fr_zi="../results/vcfs/FR_ZI_{chrom}.vcf.gz"
    output:
        "../results/vcfs/merged_FR_ZI_DGRP_{chrom}.vcf.gz"
    shell:
        """
        bcftools merge {input.fr_zi} {input.dgrp} | \
            bcftools view -m2 -M2 -g ^miss -W -o {output}
        """


# Create AncestryHMM input files

rule make_ahmm_inputs:
    # Create a file formatted as input to Ancestry HMM for the entire DGRP
    # dataset, with FR and ZI panels as ancestral proxies.
    # Arguments:
    #   -g 1 : Use genotype information instead of read counts.
    #   -m 1 : Minimum spacing between SNPs (e.g., use all SNPs).
    #   --min-diff 0 : Minimum allele frequency difference between panel
    #       populations (e.g., use all SNPs).
    input:
        script="scripts/vcf_to_ahmm.py",
        vcf="../results/vcfs/merged_FR_ZI_DGRP_{chrom}.vcf.gz",
        samples="../results/VCF_to_AHMM.samples",
        rec="../results/recomb_r6.tsv"
    output:
        table="../results/AHMM_inputs/full/FR_ZI_DGRP_{chrom}.tsv"
    shell:
        """
        python {input.script} \
            --vcf {input.vcf} \
            --samples {input.samples} \
            --rec {input.rec} \
            -g 1 \
            -m 1000 \
            --min-diff 0.1 \
            > {output.table}
        """


rule split_ahmm_inputs:
    # Split AHMM input files so that each DGRP sample has its own file
    # (to reduce the speed of AHMM runs and allow parallelization).
    input:
        script="scripts/split_ahmm_input.py",
        table="../results/AHMM_inputs/full/FR_ZI_DGRP_{chrom}.tsv",
        samples="../results/VCF_to_AHMM.samples"
    output:
        tables=expand("../results/AHMM_inputs/split/{{chrom}}_{sample}.tsv",
                      sample=SAMPLES),
        samples=expand("../results/AHMM_inputs/split/{{chrom}}_{sample}.samples",
                       sample=SAMPLES)
    params:
        prefix="../results/AHMM_inputs/split/{chrom}_"
    shell:
        """
        python {input.script} \
            -i {input.table} \
            -s {input.samples} \
            -o {params.prefix}
        """


# Run AncestryHMM

rule run_ancestry_hmm:
    # Run Ancestry HMM on sample-specific input files.
    # Ancestry HMM arguments:
    #   -a 2 0.8 0.2 : Specify two ancestral populations (FR and ZI), with
    #       prior ancestry probabilities 80%, 20%
    #   -p 0 0.8 1598 : Ancestry 0 (FR) contributed 80% of ancestry 1598
    #       generations ago (parameters from Pool, 2015).
    #   -p 0 0.2 1598 : Ancestry 1 (ZI) contributed 20% of ancestry 1598
    #       generations ago
    #   -ne 2500000 : Effective population size of the admixed population.
    #   -g : Use genotype information rather than read counts.
    # Execute Ancestry HMM in unique directories to manage output files with
    # degenerate sample names.
    input:
        table="../results/AHMM_inputs/split/{chrom}_{sample}.tsv",
        samples="../results/AHMM_inputs/split/{chrom}_{sample}.samples"
    output:
        "../results/AHMM_outputs/split/{sample}_{chrom}.posterior"
    params:
        out="{sample}.posterior",
        temp_dir="{sample}_{chrom}"
    shell:
        """
        mkdir {params.temp_dir}
        cd {params.temp_dir}
        ancestry_hmm -i ../{input.table} \
            -s ../{input.samples} \
            -a 2 0.8 0.2 \
            -p 0 0.8 1598 \
            -p 1 0.2 1598 \
            -ne 2500000 \
            -g
        cd ..
        mv {params.temp_dir}/{params.out} {output}
        rm -r {params.temp_dir}
        """


# Build tables with maximum a posterior ancestries for each sample

rule buld_ancestry_table:
    # Call ancestries using maximum a posteriori (MAP) ancestry probability
    # and merge samples into one large ancestry table.
    input:
        script="scripts/merge_ahmm_outputs.py",
        tables=expand("../results/AHMM_outputs/split/{sample}_{{chrom}}.posterior",
                      sample=SAMPLES),
        samples="../results/VCF_to_AHMM.samples",
    output:
        "../results/ancestry/full/DGRP_ancestry_{chrom}.tsv"
    shell:
        """
        python {input.script} \
            -i {input.tables} \
            -s {input.samples} \
            -o {output}
        """

rule split_chrom_ancestry_tables:
    # Break ancestry tables into ``BLOCKS`` contiguous subsets to make Fisher
    # Exact Test (FET) p-value calculation more parallelizable.
    input:
        "../results/ancestry/full/DGRP_ancestry_{chrom}.tsv"
    output:
        [f"../results/ancestry/blocks/DGRP_ancestry_{{chrom}}_{x:02d}.tsv"
         for x in range(BLOCKS)]
    params:
        prefix="../results/ancestry/blocks/DGRP_ancestry_{chrom}_",
        chunks=BLOCKS
    shell:
        """
        split -d --additional-suffix=.tsv {input} {params.prefix}
        """


# Compute Fisher Exact Tes (FET) p-values for pairwise site ancestry

rule compute_fet_pvals:
    # Compute FET p-values between unlinked chromosomes.
    input:
        script="scripts/compute_fet_pvals.py",
        block1="../results/ancestry/blocks/DGRP_ancestry_{arm1}_{i}.tsv",
        block2="../results/ancestry/blocks/DGRP_ancestry_{arm2}_{j}.tsv",
    output:
        bins_table="../results/FET_pvals/all/p_bins_{arm1}_{i}_{arm2}_{j}.tsv",
        site_table="../results/FET_pvals/all/sites_{arm1}_{i}_{arm2}_{j}.tsv",
    shell:
        """
        python {input.script} \
            -i1 {input.block1} \
            -i2 {input.block2} \
            --threshold 1e-5 \
            -b {output.bins_table} \
            -s {output.site_table}
        """

rule sum_p_values:
    input:
        tables=expand("../results/FET_pvals/all/p_bins_{pair}.tsv", pair=UNLINKED_PAIRS)
    output:
        table="../results/FET_pvals/sum_p_bins.tsv"
    run:
        sums = 0
        for filename in input.tables:
            sums += np.loadtxt(filename)[:, 1]
        np.savetxt(output.table, sums)

rule cat_sig_sites:
    input:
        expand("../results/FET_pvals/all/sites_{pair}.tsv", pair=UNLINKED_PAIRS)
    output:
        "../results/FET_pvals/sig_sites.tsv"
    shell:
        """
        cat {input} > {output}
        """
