rule extract_panel_sample_names:
    # Extract sample names from the ZI, ET, FR panel and subset to ZI, FR
    input:
        "../data/vcfs/ZI_ET_FR_combined_all_num_biallelic.vcf.gz"
    output:
        "../results/FR_ZI_samples.txt"
    shell:
        """
        bcftools query -l {input} | grep 'FR\|ZI' > {output}
        """

rule make_ahmm_to_vcf_sample_file:
    # Create a sample file for preparing Ancestry HMM input, with this format:
    #   sample_FR_0 0
    #   sample_FR_1 0
    #   sample_ZI_0 1
    #   sample_ZI_1 1
    #   sample_DGRP admixed
    input:
        dgrp="../data/vcfs/DGRP_samples.txt",
        panel="../results/FR_ZI_samples.txt"
    output:
        "../results/VCF_to_AHMM.samples"
    shell:
        """
        grep FR {input.panel} | awk '{{print $0 "\t0"}}' > {output}
        grep ZI {input.panel} | awk '{{print $0 "\t1"}}' >> {output}
        awk '{{print $0 "\tadmixed"}}' {input.dgrp} >> {output}
        """

