# Ancestry inference with Ancestry HMM and ancestry association analysis

import pandas
import numpy as np


# Helper functions

def get_chrom_code(wildcards):
    """Map a chromosome label to the corresponding numeric code, 'X' -> 4"""
    df = pandas.read_csv(
        "../data/chr_map.txt", sep="\\s+", names=["label", "code"])
    mapping = {label: code for label, code in zip(df["label"], df["code"])}
    return mapping[wildcards.chrom]


# Constants. It would be better for ``CHROMS`` to be called ``ARMS``.

BLOCKS = 10
CHROMS = ["2L", "2R", "3L", "3R", "X"]

UNLINKED_ARMS = [("X", "2L"), ("X", "2R"), ("X", "3L"), ("X", "3R"),
                 ("2L", "3L"), ("2L", "3R"),]
UNLINKED_PAIRS = []
for arm1, arm2 in UNLINKED_ARMS:
    for i in range(BLOCKS):
        for j in range(BLOCKS):
            pair = f"{arm1}_{i:02d}_{arm2}_{j:02d}"
            UNLINKED_PAIRS.append(pair)

SAMPLES = []
with open("../data/vcfs/DGRP_samples.txt", "r") as fin:
    for line in fin:
        SAMPLES.append(line.strip())


# End-product files produced by the pipeline

rule all:
    input:
        expand("../results/FET_pvals/all/p_bins_{pair}.tsv", pair=UNLINKED_PAIRS),
        expand("../results/FET_pvals/all/sites_{pair}.tsv", pair=UNLINKED_PAIRS),
        "../results/FET_pvals/sum_p_bins.tsv",
        "../results/FET_pvals/sig_sites.tsv",


# Create some input data

rule index_input_vcfs:
    # Index input VCF files
    input:
        "../data/vcfs/{dataset}.vcf.gz"
    output:
        "../data/vcfs/{dataset}.vcf.gz.csi"
    shell:
        """
        bcftools index {input}
        """

rule rebuild_rec_map:
    # Make some alterations to the input recombination map. Most significantly,
    # extend the map to chromosome arm starts/ends with rate 0.01 cM/Mb and
    # rename arms from numeric codes to strings, e.g. 7 -> 2R.
    input:
        script="scripts/rebuild_recomb.py",
        rec_map="../data/recomb_r6.txt",
        genome="../data/r6.genome"
    output:
        "../results/recomb_r6.tsv"
    shell:
        """
        python {input.script} \
            -i {input.rec_map} \
            -g {input.genome} \
            -o {output}
        """


